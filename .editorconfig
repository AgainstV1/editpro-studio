root = true

[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.{kt,kts}]
# Kotlin-specific settings
ij_kotlin_indent_size = 4
ij_kotlin_continuation_indent_size = 4
ij_kotlin_align_multiline_parameters = true
ij_kotlin_align_multiline_binary_operation = true
ij_kotlin_align_multiline_extends_list = true
ij_kotlin_wrap_on_typing = true
ij_kotlin_max_line_length = 120

# ktlint rules
ktlint_disabled_rules = trailing-whitespace,no-wildcard-imports,import-ordering